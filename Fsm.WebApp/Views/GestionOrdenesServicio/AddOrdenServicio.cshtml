@model Fsm.Application.DTOs.OrdenDeServicio.CreateOrdenDeServicioRequest

@{
    ViewData["Title"] = "Agregar Orden de Servicio";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="GestionOrdenesServicio"><i class="fa-solid fa-house"></i></a></li>
        <li class="breadcrumb-item active" aria-current="page">Agregar Orden de Servicio</li>
    </ol>
</nav>

<h3 class="mb-0">Agregar Orden de Servicio</h3>
<hr />
<p>
    Complete los siguientes campos para crear una nueva orden de servicio. Los campos con asterisco (<span class="text-danger"><b>*</b></span>) son obligatorios.
</p>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title"><i class="fa-solid fa-clipboard-list text-secondary"></i> Datos de la Orden</h4>
    </div>

    <form method="post" asp-controller="GestionOrdenesServicio" asp-action="AddOrdenServicio" id="formAddOrdenServicio">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mb-4">
                <div class="form-group col-sm-12 col-md-6">
                    <label asp-for="ClienteId">Cliente</label><span class="text-danger"> <b>*</b></span>
                    <select asp-for="ClienteId" class="form-control" asp-items="Model.Clientes">
                        <option value="">-- Seleccione un cliente --</option>
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </div>

                <div class="form-group col-sm-12 col-md-2">
                    <label asp-for="CategoriaServicio">Categoría</label><span class="text-danger"> <b>*</b></span>
                    @Html.DropDownListFor(
                             m => m.CategoriaServicio,
                             new SelectList(
                             Model.CategoriasServicio
                             .Select(cs => new { Value = (int)cs, Text = cs.ToString() })
                             .OrderBy(item => item.Value),
                             "Value",
                             "Text"
                             ),
                             "-- Seleccione --",
                             new { @class = "form-control" }
                             )
                    <span asp-validation-for="CategoriaServicio" class="text-danger"></span>
                </div>

                <div class="form-group col-sm-12 col-md-2">
                    <label asp-for="Prioridad">Prioridad</label><span class="text-danger"> <b>*</b></span>
                    @Html.DropDownListFor(
                             m => m.Prioridad,
                             new SelectList(
                             Model.Prioridades
                             .Select(p => new { Value = (int)p, Text = p.ToString() })
                             .OrderBy(item => item.Value),
                             "Value",
                             "Text"
                             ),
                             "-- Seleccione prioridad --",
                             new { @class = "form-control" }
                             )
                    <span asp-validation-for="Prioridad" class="text-danger"></span>
                </div>

                <div class="form-group col-sm-12 col-md-2">
                    <label asp-for="DetallesIds">Servicios</label><span class="text-danger"> <b>*</b></span>
                    <select asp-for="DetallesIds" class="form-control" asp-items="Model.Servicios" multiple>
                        <option value="">-- Seleccione al menos un servicio --</option>
                    </select>
                    <span asp-validation-for="DetallesIds" class="text-danger"></span>
                    <small class="form-text text-muted">Puede seleccionar múltiples servicios manteniendo presionada la tecla Ctrl mientras hace clic.</small>
                </div>

            </div>

            <div class="row mb-4">
                <div class="form-group col-sm-12 col-md-8">
                    <label asp-for="Ubicacion">Ubicación</label><span class="text-danger"> <b>*</b></span>
                    <input asp-for="Ubicacion" class="form-control" placeholder="Dirección completa donde se realizará el servicio" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>

                <div class="form-group col-sm-12 col-md-4">
                    <label asp-for="FechaAtencionEstimada">Fecha estimada de atención</label>
                    <input asp-for="FechaAtencionEstimada" class="form-control" type="date" />
                    <span asp-validation-for="FechaAtencionEstimada" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="form-group col-sm-12">
                    <label asp-for="DescripcionIncidencia">Descripción de la incidencia</label><span class="text-danger"> <b>*</b></span>
                    <textarea asp-for="DescripcionIncidencia" class="form-control" rows="4" placeholder="Describa detalladamente el problema o servicio requerido..."></textarea>
                    <span asp-validation-for="DescripcionIncidencia" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="form-group col-sm-12 col-md-6">
                    <label asp-for="TecnicoId">Técnico</label>
                    @Html.DropDownListFor(
                             m => m.TecnicoId,
                             new SelectList(Model.Tecnicos, "Value", "Text"),
                             "-- Seleccione --",
                             new { @class = "form-control" }
                             )

                    <span asp-validation-for="TecnicoId" class="text-danger"></span>
                    <small class="form-text text-muted">Puede asignar un técnico ahora o más tarde.</small>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-md-start">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                    <a asp-action="Index" asp-controller="GestionOrdenesServicio" class="btn btn-secondary ml-2">
                        <i class="fas fa-arrow-left"></i> Volver
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/addordenservicio.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@{
    ViewData["Title"] = "Bienvenido al FSM";
}

<div class="container">
    <div class="row">
        <div class="col text-center mt-5">
            <h1 class="display-4">Bienvenido al Sistema FSM</h1>
            <p class="lead">
                FSM es un sistema para coordinar operaciones de campo a través de una fuerza de trabajo móvil.
            </p>
            <hr />
            <p>
                Utilice este sistema para gestionar y monitorear sus operaciones en campo, asignar tareas y 
                optimizar la eficiencia.
            </p>
            <div class="mt-4">
                <h5>Funcionalidades Mínimas del MVP</h5>
                <p>Las funcionalidades mínimas del MVP (Mínimo producto viable) para el reto técnico</p>
                <ul class="list-unstyled">
                    <li>· Gestión de técnicos</li>
                    <li>· Gestión de clientes</li>
                    <li>· Gestión órdenes de servicio</li>
                    <li>· Seguimiento de estado de órdenes</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fsm</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!--Todos plugins-->
    <!--Font Awesome-->
    <link href="~/lib/fontawesome6.2.0/css/all.min.css" rel="stylesheet" />
    <!--Data table jquery-->
    <link href="~/lib/DataTables/DataTables-1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet" />


    <!--Data table jquery Search Panes-->
    <link rel="stylesheet" type="text/css" href="/lib/DataTables/datatables.min.css">
    <link rel="stylesheet" type="text/css" href="/lib/DataTables/SearchPanes-2.2.0/css/searchPanes.bootstrap4.min.css"> <!-- or whichever bootstrap version you're using -->


    <link href="~/lib/datatables/select-1.7.0/css/select.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/lib/datatables/datetime-1.5.1/css/datatables.datetime.min.css" rel="stylesheet" />

    <!--Data table jquery Columns-->
    <link href="~/lib/datatables/fixedheader-3.4.0/css/fixedheader.bootstrap4.min.css" rel="stylesheet" />

    <!--Sweet alert -->
    <link href="~/lib/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet" />


    <!--Highcharts -->
    <link href="~/lib/highcharts11.4.7/css/highcharts.css" rel="stylesheet" />
    <link href="~/lib/highcharts11.4.7/css/annotations/popup.css" rel="stylesheet" />

    <!--Estilo boton subir-->
    <link href="~/css/estilobotonsubir.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/Fsm.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <a class="navbar-brand" href="#">Fsm</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                            Gestión
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-controller="GestionClientes" asp-action="Index"><i class="fa-solid fa-users-gear"></i> Clientes</a>
                            <a class="dropdown-item" asp-controller="GestionOrdenesServicio" asp-action="Seguimiento"><i class="fa-solid fa-bell-concierge"></i> Ordenes de servicio</a>
                         
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="GestionOrdenesServicio" asp-action="Seguimiento"><i class="fa-regular fa-address-book"></i> Seguimiento Ordenes</a>
                    </li>
                   
                </ul>
            </div>
        </nav>

    </header>
    <div class="container-fluid">
        <!--Sweet alert 2-->
        <script src="~/lib/sweetalert2/dist/sweetalert2.min.js" asp-append-version="true"></script>
        <partial name="_NotificationPartial" />


        <main role="main" class="pb-3">
            @RenderBody()


            <!--Boton para subir al inicio de la pagina-->
            <button class="button" onclick="subirInicio()" id="btnSubirInicio"> <i class="fas fa-chevron-up fa-lg text-white"></i> </button>
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Fsm - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!--Modulo de llamados a la API-->
    <script src="~/js/apimodule.js"></script>

    <!--Data table jquery -->
    <script src="~/lib/DataTables/datatables.min.js"></script>

    <!--Data table jquery Buttons-->
    <script src="~/lib/datatables/buttons-2.4.2/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables/buttons-2.4.2/js/buttons.print.min.js"></script>

    <!--Data table jquery Search Panes-->

    <script src="~/lib/datatables/searchbuilder-1.6.0/js/searchbuilder.bootstrap4.min.js"></script>
    <script src="/lib/DataTables/SearchPanes-2.2.0/js/dataTables.searchPanes.min.js"></script>
    <script src="/lib/DataTables/SearchPanes-2.2.0/js/searchPanes.bootstrap4.min.js"></script> <!-- match your bootstrap version -->

    <script src="~/lib/datatables/select-1.7.0/js/select.bootstrap4.min.js"></script>
    <script src="~/lib/datatables/datetime-1.5.1/js/datatables.datetime.min.js"></script>
    <script src="~/lib/datatables/fixedheader-3.4.0/js/datatables.fixedheader.min.js"></script>

    <script src="~/lib/datatables/select-1.7.0/js/datatables.select.js"></script>
    <script src="~/lib/datatables/select-1.7.0/js/select.datatables.js"></script>


    @*   <!--Complemento para select2 autocompletadores y traducción al español-->
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/select2/js/i18n/es.js"></script> *@

    <!--Js para el boton subir al inicio de la pagina-->
    <script src="~/js/subirinciopagina.js"></script>

    <!--Muestra las notificaciones con Sweet Alert-->
    <script src="~/js/notificacion.js"></script>

    <!--Complemento de moment Js formatos fecha y calculos de fechas-->
    <script src="~/lib/moment/moment.js"></script>

    <!--Highcharts / Graficos-->
    <script src="~/lib/highcharts11.4.7/highcharts.js"></script>
    <script src="~/lib/highcharts11.4.7/modules/exporting.js"></script>
    <script src="~/lib/highcharts11.4.7/modules/export-data.js"></script>
    <script src="~/lib/highcharts11.4.7/modules/accessibility.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
